datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER_ADMIN
  CONFIRMATOR
  DELIVERY_AGENT
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum MovementType {
  IN_ARRIVAGE
  OUT_DELIVERY
  RETURN_RESTOCK
  ADJUSTMENT_LOSS
}

enum ExpenseCategory {
  ADS_FACEBOOK
  ADS_TIKTOK
  INVENTORY_PURCHASE
  SHIPPING_LOGISTICS
  SALARY_COMMISSION
  TOOLS_SUBSCRIPTIONS
  OTHER
}

enum RemittanceStatus {
  PENDING
  VERIFIED
  DISPUTED
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(OWNER_ADMIN)
  phone        String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  businesses   UserBusiness[]
  deliveries   Order[]        @relation("DeliveryAgentOrders")
  confirmations Order[]       @relation("ConfirmerOrders")
  remittances  CashRemittance[]
  history      StatusHistory[]
}

model Business {
  id          String         @id @default(cuid())
  name        String
  country     String         @default("Gambie")  // Gambie
  currency    String         @default("GMD")     // GMD (Dalasi)
  description String?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users       UserBusiness[]
  products    Product[]
  orders      Order[]
  expenses    Expense[]
  remittances CashRemittance[]
}

model UserBusiness {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

model Product {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  sku            String
  image          String?
  salePrice      Int             // En FCFA (sans décimales)
  costPrice      Int             // Coût de revient estimé (Achat + transport + douane)
  alertThreshold Int             @default(5)
  currentStock   Int             @default(0) // Stock physique disponible
  reservedStock  Int             @default(0) // Stock réservé (confirmé, non encore livré)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  batches        ProductBatch[]
  movements      StockMovement[]
  orderItems     OrderItem[]
}

model ProductBatch {
  id               String   @id @default(cuid())
  productId        String
  batchNumber      String
  quantityReceived Int
  unitPurchaseCost Int
  unitShippingCost Int      @default(0)
  unitCustomsCost  Int      @default(0)
  totalCostPerUnit Int
  supplier         String?
  receivedDate     DateTime @default(now())
  notes            String?

  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  type          MovementType
  quantity      Int          // Quantité déplacée (+ ou -)
  previousStock Int
  newStock      Int
  reason        String?
  orderId       String?
  createdAt     DateTime     @default(now())

  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id               String          @id @default(cuid())
  businessId       String
  orderNumber      String          @unique
  customerName     String
  customerPhone    String
  deliveryAddress  String
  zone             String
  source           String          @default("Facebook Ads") // Facebook, TikTok, WhatsApp, etc.
  status           OrderStatus     @default(NEW)
  failReason       String?         // Injoignable, Refus, Adresse introuvable, etc.
  totalAmount      Int             // Montant total à encaisser en FCFA
  deliveryFee      Int             @default(0) // Frais de livraison inclus ou ajoutés
  deliveryAgentId  String?
  confirmerId      String?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  notes            String?
  cashRemittanceId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveryAgent    User?           @relation("DeliveryAgentOrders", fields: [deliveryAgentId], references: [id])
  confirmer        User?           @relation("ConfirmerOrders", fields: [confirmerId], references: [id])
  remittance       CashRemittance? @relation(fields: [cashRemittanceId], references: [id])
  items            OrderItem[]
  statusHistory    StatusHistory[]
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  quantity        Int      @default(1)
  unitPrice       Int
  frozenCostPrice Int      // Coût de revient figé au moment de la commande

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
}

model StatusHistory {
  id            String       @id @default(cuid())
  orderId       String
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  changedById   String
  changedByName String
  note          String?
  createdAt     DateTime     @default(now())

  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [changedById], references: [id])
}

model Expense {
  id            String          @id @default(cuid())
  businessId    String?         // Nullable si dépense partagée entre tous les business
  date          DateTime        @default(now())
  category      ExpenseCategory
  amount        Int             // En FCFA
  paymentMethod String          @default("Wave") // Wave, Orange Money, Espèces, etc.
  note          String?
  receiptUrl    String?         // URL Vercel Blob du justificatif
  adPlatform    String?         // Facebook Ads, TikTok Ads
  campaignName  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business      Business?       @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model CashRemittance {
  id              String           @id @default(cuid())
  deliveryAgentId String
  businessId      String
  date            DateTime         @default(now())
  expectedAmount  Int              // Montant attendu des commandes livrées
  remittedAmount  Int              // Montant effectivement remis par le livreur
  discrepancy     Int              @default(0) // Écart (remitted - expected)
  status          RemittanceStatus @default(PENDING)
  verifiedById    String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  deliveryAgent   User             @relation(fields: [deliveryAgentId], references: [id])
  business        Business         @relation(fields: [businessId], references: [id])
  orders          Order[]
}

model DeliveryZone {
  id                 String   @id @default(cuid())
  name               String
  country            String   @default("Gambie")
  city               String   @default("Kanifing")
  defaultDeliveryFee Int      @default(150) // ex: 150 GMD
  active             Boolean  @default(true)
}
