# ==========================================
# GAMBIA TRACK — ENV CONFIGURATION (Vercel & Neon)
# ==========================================

# 1. Base de données Neon PostgreSQL (avec connection pooling serverless)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Authentification Auth.js / NextAuth
NEXTAUTH_SECRET="votre_cle_secrete_ultra_securisee_generer_avec_openssl"
NEXTAUTH_URL="http://localhost:3000"

# 3. Stockage photos & justificatifs (Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# 4. Paramètres métier
NEXT_PUBLIC_DEFAULT_CURRENCY="XOF"
NEXT_PUBLIC_TIMEZONE="Africa/Dakar"
